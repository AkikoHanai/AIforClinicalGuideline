# Copy this file to .env and fill values on each Mac.
# Never commit .env or paste real keys into documentation.

# Claude API (required only for Direct API recommendation generation)
ANTHROPIC_API_KEY=

# PubMed E-utilities (optional; increases request allowance)
NCBI_API_KEY=

# AWS / Bedrock. Prefer an AWS profile instead of long-lived access keys.
AWS_PROFILE=default
AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1
BEDROCK_MODEL_ID=

# AWS pipeline values (required only for AWS execution)
SR_S3_BUCKET=
SR_JOB_ID=

# Local paths are configured separately in config/paths.local.env.
