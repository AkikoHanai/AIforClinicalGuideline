# Copy to config/paths.local.env on each Mac and edit for that machine.
# Use absolute paths. This file contains no API keys.

# Synced Google Drive folder containing Minds templates and guideline materials.
GL_GOOGLE_DRIVE_ROOT=""

# Local working copy for generated review bundles and temporary analysis outputs.
GL_LOCAL_WORKSPACE=""

# Default output directory. Relative paths are resolved from the repository root.
GL_OUTPUT_ROOT="./sr_output"

# Optional existing CIPN review platform directory.
GL_REVIEW_PLATFORM_ROOT=""
